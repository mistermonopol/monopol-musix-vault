{
  "name": "@monopol-musix-vault/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Monopol Musix Vault API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "node tests/auth.e2e.mjs",
    "test:obsidian:e2e": "node tests/obsidian.e2e.mjs",
    "test:scanner:e2e": "node tests/scanner.e2e.mjs",
    "test:streaming:e2e": "node tests/streaming.e2e.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.2",
    "jose": "^6.2.8",
    "music-metadata": "^11.14.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
